Option Explicit
Public Enum Mode
    Fast = -1
    Slow = Fast + 11
End Enum
Public Const Version As String = "1.2"
Private n As Long
Friend Function Bump() As Long
    n = n + 1: Bump = n
End Function
Public Static Function Calls() As Long
    Dim c As Long
    c = c + 1
    Calls = c
End Function
Public Function Describe(Optional ByVal m As Mode = Slow) As String
    Describe = "mode=" & m & " v" & Version
End Function
