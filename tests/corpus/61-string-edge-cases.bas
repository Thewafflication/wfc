Sub T(label As String, v As Variant)
    If IsNull(v) Then
        Print label & "=Null"
    ElseIf IsArray(v) Then
        Print label & "=array(" & LBound(v) & "," & UBound(v) & ")" & Join(v, "|")
    Else
        Print label & "=" & v
    End If
End Sub
