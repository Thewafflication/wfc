# Capture King: leave the splash screen, start a local game, play four moves.
wait 3500
click frmWelcome.picLocalGame
wait 300
mousedown frmGame.picboard(52) 1 0 10 10
drag frmGame.picboard(52) frmGame.picboard(36) 10 10
wait 100
mousedown frmGame.picboard(12) 1 0 10 10
drag frmGame.picboard(12) frmGame.picboard(28) 10 10
wait 100
mousedown frmGame.picboard(62) 1 0 10 10
drag frmGame.picboard(62) frmGame.picboard(45) 10 10
wait 100
mousedown frmGame.picboard(1) 1 0 10 10
drag frmGame.picboard(1) frmGame.picboard(18) 10 10
wait 300
